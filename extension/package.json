{
  "name": "vmecdash-viewer",
  "displayName": "VMECdash Viewer",
  "description": "Native VS Code viewer for VMEC wout NetCDF equilibria.",
  "version": "0.1.1",
  "publisher": "HengqianLiu",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DMCXE/VMECdash.git",
    "directory": "extension"
  },
  "homepage": "https://github.com/DMCXE/VMECdash#readme",
  "bugs": {
    "url": "https://github.com/DMCXE/VMECdash/issues"
  },
  "keywords": [
    "vmec",
    "stellarator",
    "tokamak",
    "plasma",
    "equilibrium",
    "netcdf",
    "plotly",
    "fusion"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onCustomEditor:vmecdash.woutPreview",
    "onCommand:vmecdash.openPreview",
    "onCommand:vmecdash.checkBackend",
    "onCommand:vmecdash.selectPython"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "vmecdash.woutPreview",
        "displayName": "VMECdash Preview",
        "selector": [
          {
            "filenamePattern": "**/wout*.nc"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "vmecdash.openPreview",
        "title": "VMECdash: Open Preview"
      },
      {
        "command": "vmecdash.checkBackend",
        "title": "VMECdash: Check Backend"
      },
      {
        "command": "vmecdash.selectPython",
        "title": "VMECdash: Select Python Path"
      }
    ],
    "configuration": {
      "title": "VMECdash",
      "properties": {
        "vmecdash.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to a Python executable that has the 'vmecdash' package installed, used to run 'python -m vmecdash.vscode_backend --stdio'. Set this at User scope to apply to every workspace. Resolution order: this setting, then the VMECDASH_PYTHON environment variable, then the Python extension's selected interpreter, then python3/python on PATH."
        },
        "vmecdash.backendArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional arguments passed to the VMECdash backend."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}

